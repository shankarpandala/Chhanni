# Gmail OAuth client (Desktop application type).
# Create one at https://console.cloud.google.com/apis/credentials
# and enable the Gmail API for the project.
#
# Required scopes (configured in code, not here):
#   - https://www.googleapis.com/auth/gmail.readonly
#   - openid email
#
# These vars are read by the Rust core at runtime via
# auth::gmail::load_credentials(). They are NEVER persisted or logged.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
