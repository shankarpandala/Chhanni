# Gmail OAuth client (Desktop application type).
# Create one at https://console.cloud.google.com/apis/credentials
# and enable the Gmail API for the project.
#
# Required scopes (configured in code, not here):
#   - https://www.googleapis.com/auth/gmail.readonly
#   - openid email
#
# These vars are read by the Rust core at runtime via
# auth::gmail::load_credentials(). They are NEVER persisted or logged.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Microsoft Graph OAuth client (Desktop / native client type).
# Register at https://entra.microsoft.com → App registrations → New registration.
# Configure the redirect URI as "http://localhost" (Tauri reads the loopback
# port at runtime and adds the path; Microsoft accepts any loopback port).
# Required delegated permissions: Mail.ReadWrite, offline_access, User.Read,
# openid, email, profile.
#
# Public clients do NOT need a client secret. Leave GRAPH_CLIENT_SECRET unset.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
